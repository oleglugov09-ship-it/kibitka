[internationalization]
locale/translations=PackedStringArray("res://addons/maaacks_menus_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.ru.translation")
locale/fallback="ru"

[gui]
common/drop_mouse_on_gui_input_disabled=true
; Текст — точками, без сглаживания: картинка 640x360, сглаженные буквы в 7 точек расплываются.
theme/default_font_antialiasing=0
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0

[maaacks_menus_template]
disable_update_check=true
disable_install_wizard=true
disable_install_audio_busses=true
main_menu_scene_path=""
game_scene_path="res://main.tscn"

[maaacks_music_controller]
disable_install_audio_busses=true

[maaacks_ui_sound_controller]
disable_install_audio_busses=true

[editor_plugins]
enabled=PackedStringArray("res://addons/maaacks_menus_template/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")
