{
  // Room server for playing by code: relays messages between the driver and the guests.
  // Sized for Cloudflare's free plan (SQLite-backed Durable Objects, hibernating sockets).
  "name": "kibitka-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "LOG", "class_name": "Log" }, { "name": "DIR", "class_name": "Dir" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Log"] }, { "tag": "v3", "new_sqlite_classes": ["Dir"] }]
}
